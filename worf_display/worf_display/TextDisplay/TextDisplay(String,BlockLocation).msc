@using worf_display

@var this.uuid = Int[math::randomInt(), math::randomInt(), math::randomInt(), math::randomInt()]
@var this.groupIdentifier = groupIdentifier
@var this.anchor = anchor

@var this.rotation = Quaternion(0D,0D,0D,1D)
@var this.translation = Vector3(0,0,0)
@var this.scale = Vector3(1,1,1)

@var this.text = DisplayText[]

@var this.lineWidth = 160
@var this.textOpacity = 255
@var this.background = 1073741824
@var this.alignment = "center"