@using worf_display

@fast

@define String textCombo = ""

@for DisplayText textPart in this.text
    @var textCombo += "{'bold':" + textPart.bold + ",'color':" + textPart.textColor + ",'italic':" + textPart.italic + ",'obfuscated':" + textPart.obfuscated + ",'strikethrough':" + textPart.strikethrough + ",'text':'" + textPart.text + "','underlined':" + textPart.underlined + " },"
@done

# trim last comma
@var textCombo = textCombo.substring(0,textCombo.length()-1)

@console /execute in {{this.anchor.getWorld().toLowerCase()}} run summon text_display {{this.anchor.getX()}} {{this.anchor.getY()}} {{this.anchor.getZ()}} {UUID:[I;{{this.uuid[0]}},{{this.uuid[1]}},{{this.uuid[2]}},{{this.uuid[3]}}],line_width:{{this.lineWidth}},text_opacity:{{this.textOpacity}},alignment:{{this.alignment}},Tags:[{{"worf_display_text_" + this.groupIdentifier}}],transformation:{left_rotation:[{{this.rotation}}],right_rotation:[0f,0f,0f,1f],translation:[{{this.translation.getX()}}f,{{this.translation.getY()}}f,{{this.translation.getZ()}}f],scale:[{{this.scale.getX()}}f,{{this.scale.getY()}}f,{{this.scale.getZ()}}f]},text:[{{textCombo}}],background:{{this.background}} }