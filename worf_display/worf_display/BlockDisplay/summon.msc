@using worf_display

@fast

@define String properties = ""

@if this.properties.equalsIgnoreCase("") == false
    @var properties = ",properties:{" + this.properties + "} }"
@fi

@console /execute in {{this.anchor.getWorld().toLowerCase()}} run summon block_display {{this.anchor.getX()}} {{this.anchor.getY()}} {{this.anchor.getZ()}} {UUID:[I;{{this.uuid[0]}},{{this.uuid[1]}},{{this.uuid[2]}},{{this.uuid[3]}}],block_state:{id:{{this.block}}{{properties}} },Tags:[{{"worf_display_block_" + this.groupIdentifier}}],transformation:{left_rotation:[{{this.rotation}}],right_rotation:[0f,0f,0f,1f],translation:[{{this.translation.getX()}}f,{{this.translation.getY()}}f,{{this.translation.getZ()}}f],scale:[{{this.scale.getX()}}f,{{this.scale.getY()}}f,{{this.scale.getZ()}}f]} }