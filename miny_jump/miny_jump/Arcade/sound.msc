@fast

@define BlockVector3 min = this.announceArea.getMinimumPoint().asBlockVector3()
@define BlockVector3 dist = this.announceArea.getMaximumPoint().asBlockVector3() - min

# msc-ignore SEM005
@console /execute in {{this.anchor.getWorld().toLowerCase()}} run playsound {{sound}} record @a[x={{min.getX()}}, y={{min.getY()}}, z={{min.getZ()}}, dx={{dist.getX()}}, dy={{dist.getY()}}, dz={{dist.getZ()}}] {{this.anchor.asBlockVector3() + position.asBlockVector3()}} 2 {{pitch}} 0.5